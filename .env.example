# Sao chep file nay thanh .env.local roi dien gia tri that.
# .env.local da nam trong .gitignore nen khong bi day len GitHub.

# URL Web App cua Apps Script, ket thuc bang /exec
GAS_URL=https://script.google.com/macros/s/xxxxxxxxxxxxxxxxxxxx/exec

# Khoa dung chung giua Vercel va Apps Script.
# Lay bang cach chay ham xemAppKey() trong trinh soan thao Apps Script.
GAS_APP_KEY=

# Bi mat de ky cookie phien. Sinh bang lenh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
